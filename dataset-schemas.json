{
  "datasets": [
    {
      "name": "X-Wing | Fleet Master",
      "description": "Aircraft registry with tail numbers, serial numbers, models, status, and current times. Source: Fleet Asset Report from 135 ACM.",
      "schema": {
        "columns": [
          {
            "name": "tail_number",
            "type": "STRING"
          },
          {
            "name": "serial_number",
            "type": "STRING"
          },
          {
            "name": "model",
            "type": "STRING"
          },
          {
            "name": "status",
            "type": "STRING",
            "description": "STANDBY, MEL, CUST, or null (available)"
          },
          {
            "name": "engine_sn",
            "type": "STRING"
          },
          {
            "name": "total_time",
            "type": "DECIMAL"
          },
          {
            "name": "total_landings",
            "type": "LONG"
          },
          {
            "name": "total_cycles",
            "type": "LONG"
          },
          {
            "name": "last_updated",
            "type": "DATETIME"
          },
          {
            "name": "upload_source",
            "type": "STRING",
            "description": "Original filename for audit trail"
          }
        ]
      }
    },
    {
